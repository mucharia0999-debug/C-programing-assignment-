#include <stdio.h>
#include <stdlib.h>

int main(void) {
    const char *filename = "sales.txt";
    FILE *fp = fopen(filename, "r");
    if (fp == NULL) {
        perror("Error opening sales.txt");
        return 1;
    }

    double total = 0.0;
    double amount;
    int count = 0;

   
    while (fscanf(fp, " %lf", &amount) == 1) {
        total += amount;
        count++;
    }

   
    if (ferror(fp)) {
        perror("Error reading file");
        fclose(fp);
        return 1;
    }

    printf("Read %d transaction%s\n", count, (count == 1 ? "" : "s"));
    printf("Total sales for the day = Ksh %.2f\n", total);

    if (fclose(fp) != 0) {
        perror("Error closing file");
        return 1;
    }

    return 0;
}